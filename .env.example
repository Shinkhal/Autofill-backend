NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/jobautofill
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-32-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
TRUST_PROXY=0
# Optional job listing provider credentials
RAPIDAPI_KEY=
JOOBLE_API_KEY=

# Configuration and logging
MONGODB_DB_NAME=jobautofill
LOG_LEVEL=info

# Optional Redis: configure both REST values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional TCP URL for future queue workers (rediss:// in production).
UPSTASH_REDIS_TCP_URL=
